# PlatformIO/GCC flags that host clangd does not understand.
CompileFlags:
  Add:
    - --target=riscv32-unknown-elf
    - --sysroot=/Users/jangwon/.platformio/packages/toolchain-riscv32-esp/riscv32-esp-elf
    - -isystem/Users/jangwon/.platformio/packages/toolchain-riscv32-esp/riscv32-esp-elf/include
    - -isystem/Users/jangwon/.platformio/packages/toolchain-riscv32-esp/riscv32-esp-elf/include/c++/14.2.0
    - -isystem/Users/jangwon/.platformio/packages/toolchain-riscv32-esp/riscv32-esp-elf/include/c++/14.2.0/riscv32-esp-elf
  Remove:
    - -fno-tree-switch-conversion
    - -fstrict-volatile-bitfields
    - -fno-jump-tables
    - -freorder-blocks
    - -m*
    - -fobject-size*
    - -fno-shrink-wrap
